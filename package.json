{
  "name": "n8n-nodes-trackpod",
  "version": "0.1.5",
  "description": "n8n community node for the Track-POD delivery management platform",
  "keywords": [
    "n8n-community-node-package",
    "track-pod",
    "delivery",
    "logistics"
  ],
  "author": {
    "name": "Muhammad Otah Bashi",
    "email": "muhammad.otahbashi@altruan.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bashlenix/Trackpod_n8n_Custom_Node.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TrackPodApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TrackPod/TrackPod.node.js",
      "dist/nodes/TrackPod/TrackPodTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^14.14.37",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
